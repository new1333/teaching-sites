  "chapter": "06-financial-statements",
  "title": "财报三张表：利润是观点，现金是事实",
  "as_of": "2026-09",
  "unit": "金额单位：亿元",
  "note": "公司甲、乙为教学用匿名合成公司，与任何真实上市公司无关；科目远少于真实财报，真实报表阅读路径在差异附录给出。康美药业案例数字引自证监会行政处罚决定书〔2020〕24号（2020-05-14公布），不在本 fixture 内。",
  "conventions": {
    "ratio_unit": "比率与增速以小数存储，呈现为百分数保留 2 位小数（0.1295 = 12.95%）",
    "money_rounding": "金额四舍五入保留 2 位小数（src/round.ts round2）",
    "ratio_rounding": "比率一步算完再舍入：百分数保留 2 位小数，即小数保留 4 位（src/statements.ts roundRatio）",
    "indicator_formulas": {
      "gross_margin": "毛利率 =（营业收入 − 营业成本）÷ 营业收入",
      "net_margin": "净利率 = 净利润 ÷ 营业收入",
      "ocf_to_profit": "利润含金量 = 经营现金流净额 ÷ 净利润",
      "recv_vs_revenue_gap": "应收-营收增速差 = 应收账款增速 − 营业收入增速（2025 年报对 2024 年报；百分点 = 小数 × 100）",
      "cash_to_debt": "现金债务覆盖 = 期末货币资金 ÷ 期末有息负债"
    },
    "judgement_rules": {
      "ocf_to_profit": "连续三年 ≥ 1（100%）为健康；逐年下滑且报告期转负为红旗",
      "recv_vs_revenue_gap": "差值在 ±0.05（±5 个百分点）内为温和；> 0.20（20 个百分点）为激增红旗",
      "cash_to_debt": "≥ 1（100%）为覆盖无虞；若同时利润含金量 < 1（经营不造血），账上大额现金记「存贷双高」嫌疑",
      "verdict": "无红旗 = 健康；任一红旗 = 体检不通过"
    }
  },
